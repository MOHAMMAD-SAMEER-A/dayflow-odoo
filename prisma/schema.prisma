datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HR_OFFICER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum TimeOffType {
  PAID
  SICK
  UNPAID
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String   @unique @map("employee_id") @db.VarChar(50)
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  role          Role
  companyName   String   @map("company_name") @db.VarChar(100)
  avatarUrl     String?  @map("avatar_url") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  employeeProfile   EmployeeProfile?
  attendance        Attendance[]
  timeOffRequests   TimeOffRequest[]
  salaryStructure   SalaryStructure?

  @@map("users")
}

model EmployeeProfile {
  userId         String   @id @map("user_id") @db.Uuid
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  phone          String?  @db.VarChar(20)
  address        String?  @db.Text
  jobTitle       String   @map("job_title") @db.VarChar(100)
  department     String   @db.VarChar(100)
  aboutMe        String?  @map("about_me") @db.Text
  skills         String[] @db.Text
  certifications String[] @db.Text
  dateOfJoining  DateTime @map("date_of_joining") @db.Date
  bankDetails    Json?    @map("bank_details")
  nationalId     String?  @map("national_id") @db.VarChar(50)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

model Attendance {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  date         DateTime         @db.Date
  checkInTime  DateTime?        @map("check_in_time") @db.Timestamptz(6)
  checkOutTime DateTime?        @map("check_out_time") @db.Timestamptz(6)
  totalHours   Decimal?         @map("total_hours") @db.Decimal(5, 2)
  status       AttendanceStatus

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("attendance")
}

model TimeOffRequest {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  type          TimeOffType
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  remarks       String?       @db.Text
  attachmentUrl String?       @map("attachment_url") @db.Text
  status        TimeOffStatus @default(PENDING)
  adminComment  String?       @map("admin_comment") @db.Text

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_off_requests")
}

model SalaryStructure {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                      String   @unique @map("user_id") @db.Uuid
  monthlyWage                 Decimal  @map("monthly_wage") @db.Decimal(12, 2)
  yearlyWage                  Decimal  @map("yearly_wage") @db.Decimal(12, 2)
  workingDaysPerWeek          Int      @default(5) @map("working_days_per_week")
  basicPercentage             Decimal  @default(50.00) @map("basic_percentage") @db.Decimal(5, 2)
  hraPercentage               Decimal  @default(20.00) @map("hra_percentage") @db.Decimal(5, 2)
  standardAllowancePercentage Decimal  @default(10.00) @map("standard_allowance_percentage") @db.Decimal(5, 2)
  performanceBonusPercentage  Decimal  @default(10.00) @map("performance_bonus_percentage") @db.Decimal(5, 2)
  fixedAllowance              Decimal  @default(0.00) @map("fixed_allowance") @db.Decimal(12, 2)
  pfDeduction                 Decimal  @default(0.00) @map("pf_deduction") @db.Decimal(12, 2)
  professionalTax             Decimal  @default(0.00) @map("professional_tax") @db.Decimal(12, 2)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}
